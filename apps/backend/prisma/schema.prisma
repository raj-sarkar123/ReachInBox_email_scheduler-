generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  RATE_LIMITED_RESCHEDULED
}

model User {
  id              String           @id @default(uuid())
  googleId        String?          @unique @map("google_id")
  email           String           @unique
  name            String
  avatar          String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  
  senders         Sender[]
  campaigns       Campaign[]
  emails          Email[]
  slackConnection SlackConnection?

  @@map("users")
}

model Sender {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  name         String
  smtpHost     String?    @map("smtp_host")
  smtpPort     Int?       @default(587) @map("smtp_port")
  smtpUser     String?    @map("smtp_user")
  smtpPass     String?    @map("smtp_pass")
  hourlyLimit  Int        @default(100) @map("hourly_limit")
  delaySeconds Int        @default(2) @map("delay_seconds")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  campaigns    Campaign[]
  emails       Email[]

  @@unique([userId, email], name: "uq_user_sender_email")
  @@map("senders")
}

model Campaign {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId        String         @map("sender_id")
  sender          Sender         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  subject         String
  body            String         @db.Text
  startTime       DateTime       @map("start_time")
  delaySeconds    Int            @default(2) @map("delay_seconds")
  hourlyLimit     Int            @default(100) @map("hourly_limit")
  status          CampaignStatus @default(SCHEDULED)
  totalRecipients Int            @default(0) @map("total_recipients")
  sentCount       Int            @default(0) @map("sent_count")
  failedCount     Int            @default(0) @map("failed_count")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  emails          Email[]

  @@map("campaigns")
}

model Email {
  id                 String      @id @default(uuid())
  campaignId         String      @map("campaign_id")
  campaign           Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  senderId           String      @map("sender_id")
  sender             Sender      @relation(fields: [senderId], references: [id], onDelete: Restrict)
  userId             String      @map("user_id")
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient          String
  subject            String
  body               String      @db.Text
  scheduledAt        DateTime    @map("scheduled_at")
  sentAt             DateTime?   @map("sent_at")
  status             EmailStatus @default(SCHEDULED)
  bullmqJobId        String?     @unique @map("bullmq_job_id")
  idempotencyKey     String      @unique @map("idempotency_key")
  failureReason      String?     @map("failure_reason") @db.Text
  etherealMessageId  String?     @map("ethereal_message_id")
  etherealPreviewUrl String?     @map("ethereal_preview_url") @db.Text
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@index([recipient])
  @@index([scheduledAt])
  @@index([status])
  @@index([userId])
  @@map("emails")
}

model SlackConnection {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slackUserId         String   @map("slack_user_id")
  teamId              String   @map("team_id")
  teamName            String   @map("team_name")
  channelId           String?  @map("channel_id")
  channelName         String?  @map("channel_name")
  accessToken         String   @map("access_token") @db.Text
  incomingWebhookUrl  String?  @map("incoming_webhook_url") @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("slack_connections")
}
